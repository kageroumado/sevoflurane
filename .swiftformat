# Swift version (enables modern syntax-aware rules)
--swiftversion 6.2

# Wrapping style
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first

# Attribute placement
--funcattributes prev-line
--typeattributes prev-line

# Enabled rules
--enable blankLineAfterImports,blockComments,wrapEnumCases,wrapSingleLineComments

# Disabled rules. redundantSelf is off: under Swift 6 strict concurrency it strips `self.` that the
# compiler REQUIRES in escaping/Sendable closures, breaking the build. Leave self management to the
# author.
#
# The whole `wrap*Bodies` family is off. SwiftFormat turned them on by default across 0.62 and 0.63,
# and every one of them expands a body this codebase writes on one line deliberately:
# `if cond { return }`, `for pid in tree { kill(pid, SIGCONT) }`, `var isActive: Bool { NSApp.isActive }`,
# `func id() -> String { rawValue }`. A single-line body is the house style wherever the body is one
# expression; the rules disagree, and they are the ones that are wrong here.
--disable wrapMultilineStatementBraces,wrapMultilineConditionalAssignment,blankLinesBetweenScopes,redundantInternal,redundantSelf,wrapIfStatementBodies,wrapIfExpressionBodies,wrapLoopBodies,wrapPropertyBodies,wrapFunctionBodies

# Header stripping
--header strip

# Numeric formatting — left as written. No threshold serves both `8081`, which is
# a port and must not be broken up, and `5_000`, which is a byte count and reads
# better grouped; the author knows which one a literal is.
--decimalgrouping ignore

# Import grouping
--importgrouping testable-last

# Preserve indentation on empty lines
--trimwhitespace nonblank

# Build artifacts — never format these.
--exclude .build,**/.build,build,DerivedData,.swiftpm
