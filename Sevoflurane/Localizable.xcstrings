            "value" : "已由 sevo 停止"
          }
        }
      }
    },
    "stopped by Steam" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已由 Steam 停止"
          }
        }
      }
    },
    "stopped on request" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已按要求停止"
          }
        }
      }
    },
    "Stopped. Running it again keeps what was downloaded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止。再次运行会保留已下载的内容。"
          }
        }
      }
    },
    "Stops every Windows process in the bottle, Wine's server included, and starts again. For when restarting Steam has not helped." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止容器中的所有 Windows 进程（包括 Wine 服务），然后重新启动。适用于重启 Steam 仍无法解决问题的情况。"
          }
        }
      }
    },
    "Stops Steam and installs the client over this bottle again — for a client whose own files are damaged and that Repair leaves alone. Your games and saves stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止 Steam，并在现有容器中重新安装客户端。适用于客户端文件损坏、常规修复无法解决的情况。游戏和存档会保留。"
          }
        }
      }
    },
    "Storage" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储空间"
