    },
    "Steam's folder" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 文件夹"
          }
        }
      }
    },
    "Steam’s interface runs in native WKWebViews at the screen’s real scale, with its menus in the menu bar and Mac notifications." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 界面以屏幕的原生分辨率显示，菜单位于菜单栏中，通知则由 macOS 显示。"
          }
        }
      }
    },
    "Steam's menus freeze and the app looks stuck." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
