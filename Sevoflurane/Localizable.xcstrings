    "One of them, with nothing to fall back to." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只使用所选版本，不回退到另一版本。"
          }
        }
      }
    },
    "One setting for the whole bottle, read by each game as it starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置适用于整个容器，每个游戏启动时都会读取。"
          }
        }
      }
    },
    "One switch for reproducing a bug: it sets everything a report needs, and takes it all off again when it ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个开关即可开启重现问题所需的全部记录。关闭后会恢复原有设置。"
          }
        }
      }
    },
    "Only the built-in engine includes the Discord relay. Select it in Engine settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有内建引擎包含 Discord 中继。请在“引擎”设置中选择它。"
          }
        }
      }
    },
