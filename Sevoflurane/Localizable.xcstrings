          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过登录"
          }
        }
      }
    },
    "Some older games start one worker thread per processor and keep them all busy; fewer processors let them rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些旧游戏为每个处理器启动一个工作线程，并让它们全部保持忙碌；减少处理器数量能让它们歇下来。"
          }
        }
      }
    },
    "SourceHanSans%@.zip refused to unzip" : {
