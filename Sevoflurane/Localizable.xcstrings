          }
        }
      }
    },
    "First window" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首个窗口"
          }
        }
      }
    },
    "Fits what the upscaler made to the window's exact size: all of the resizing with no shader, the last few percent after one. Lanczos is sharp, Bilinear soft, Nearest keeps hard pixel edges." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将画面缩放器的输出适配到窗口的精确尺寸：没有着色器时完成全部缩放，有着色器时完成最后少量缩放。Lanczos 更锐利，双线性更柔和，最近邻保留清晰的像素边缘。"
          }
        }
      }
    },
    "Fixed-size windows" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定尺寸窗口"
          }
        }
      }
    },
    "Fixed-size windows and full-screen games" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定尺寸窗口和全屏游戏"
          }
        }
      }
    },
    "Fixes “VCRUNTIME140.dll was not found” and “MSVCP140.dll is missing” at launch." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复启动时出现的“找不到 VCRUNTIME140.dll”和“缺少 MSVCP140.dll”错误。"
          }
        }
      }
    },
    "Fixes a d3dx9_43.dll error, and silent audio in games built on old XAudio and XACT." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复 d3dx9_43.dll 错误，以及使用旧版 XAudio 和 XACT 的游戏没有声音的问题。"
          }
        }
      }
    },
    "Fixes blank labels and boxes in launchers and older games." : {
      "extractionState" : "manual",
      "localizations" : {
