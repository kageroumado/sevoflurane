    "Steam starting" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在启动"
          }
        }
      }
    },
    "Steam starts and stops only when you ask." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 只会在你手动操作时启动或停止。"
          }
        }
      }
    },
    "Steam stopped" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已停止"
          }
        }
      }
    },
    "Steam stops, its installer runs over the bottle again, and the client downloads itself fresh. Long — tens of minutes on a slow line. Your games and saves stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 会停止，安装程序会在现有容器中重新运行，客户端也会重新下载。网络较慢时可能需要数十分钟。游戏和存档会保留。"
          }
        }
      }
    },
    "Steam stops, its shader cache is trashed, and it reopens and rebuilds the shaders. Your games and saves stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 会停止，着色器缓存会移到废纸篓。重新启动后，Steam 会重建着色器。游戏和存档会保留。"
          }
        }
      }
    },
    "Steam, always Retina" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 始终以视网膜分辨率显示"
          }
        }
      }
    },
    "Steam's API beside it" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁边有 Steam API"
