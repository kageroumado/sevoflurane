        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭冻结的 Steam 菜单。Steam 菜单可能在 macOS 27 中卡住。"
          }
        }
      }
    },
    "Energy" : {
